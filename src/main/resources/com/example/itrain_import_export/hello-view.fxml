<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.itrain_import_export.HelloController">
    <top>
        <VBox>
            <MenuBar>
                <Menu fx:id="fileMenu" text="Datei">
                    <MenuItem fx:id="openMenuItem" text="Öffnen..." onAction="#onOpenFile"/>
                    <MenuItem fx:id="saveMenuItem" text="Speichern unter..." onAction="#onSaveAs"/>
                    <MenuItem fx:id="closeFileMenuItem" text="Aktuelle schließen" onAction="#onCloseFile"/>
                    <SeparatorMenuItem/>
                    <!-- Inhalt (bis zu 5 zuletzt geöffnete Dateien, oder ein
                         deaktivierter Platzhalter) wird zur Laufzeit vom
                         Controller aufgebaut, siehe
                         HelloController.refreshRecentFilesMenu(). -->
                    <Menu fx:id="recentFilesMenu" text="Zuletzt verwendet..."/>
                    <MenuItem fx:id="loadBackupMenuItem" text="Backup laden..." onAction="#onLoadBackup"/>
                    <MenuItem fx:id="exportFilesMenuItem" text="Export Dateien" onAction="#onOpenExportFiles"/>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="exitMenuItem" text="Programm beenden" onAction="#onExit"/>
                </Menu>
                <Menu fx:id="editMenu" text="Bearbeiten">
                    <MenuItem fx:id="undoMenuItem" text="Rückgängig" onAction="#onUndo"/>
                    <MenuItem fx:id="redoMenuItem" text="Wiederholen" onAction="#onRedo"/>
                    <!-- Getrennt, weil es nichts an den Daten ändert, sondern
                         nur die Fenster wieder einsammelt. -->
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="centerWindowsMenuItem" text="Alle Fenster zentrieren" onAction="#onCenterWindows"/>
                    <!-- Seit 2.5: dieselben Aktionen wie die pastellfarbenen
                         Ribbon-Knöpfe, hier zusätzlich als Menüpunkt. -->
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="editExportSelectedMenuItem" text="Export ausgewählte Kategorie" onAction="#onExportSelected"/>
                    <MenuItem fx:id="editImportCategoryMenuItem" text="Import Kategorie" onAction="#onImportCategory"/>
                </Menu>
                <!-- Seit 2.5 nur noch die Voreinstellungen. "Decoder-Vorlagen"
                     und "Decoder-Vorlagen installieren" sind ins Menü
                     "Decoder" des Decoder-Fensters gewandert (DecoderWindow). -->
                <Menu fx:id="settingsMenu" text="Einstellungen">
                    <MenuItem fx:id="preferencesMenuItem" text="Voreinstellungen" onAction="#onPreferences"/>
                </Menu>
                <!-- Seit 2.5: führt zu den beiden anderen Programmteilen -
                     dieselbe Öffnen-oder-nach-vorn-Wirkung wie die
                     gleichnamigen Ribbon-Knöpfe (siehe onOpenDecoderWindow/
                     onOpenSystemsWindow). -->
                <Menu fx:id="functionsMenu" text="Funktionen">
                    <MenuItem fx:id="functionsDecoderMenuItem" text="Decoder" onAction="#onOpenDecoderWindow"/>
                    <MenuItem fx:id="functionsSystemsMenuItem" text="Systeme" onAction="#onOpenSystemsWindow"/>
                </Menu>
                <Menu fx:id="helpMenu" text="Hilfe">
                    <MenuItem fx:id="helpMenuItem" text="Hilfe" onAction="#onHelp"/>
                    <MenuItem fx:id="manualMenuItem" text="Handbuch" onAction="#onOpenManual"/>
                    <MenuItem fx:id="updateMenuItem" text="Update" onAction="#onCheckForUpdate"/>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="aboutMenuItem" text="Über" onAction="#onAbout"/>
                </Menu>
            </MenuBar>
            <ToolBar fx:id="ribbonToolBar">
                <Button fx:id="openToolButton" onAction="#onOpenFile"/>
                <Button fx:id="saveToolButton" onAction="#onSaveAs"/>
                <Button fx:id="undoToolButton" onAction="#onUndo"/>
                <Button fx:id="redoToolButton" onAction="#onRedo"/>
                <Button fx:id="preferencesToolButton" onAction="#onPreferences"/>
                <!-- Trennstrich: rechts davon die Import-/Export-
                     Schaltflächen, die auf den gerade sichtbaren
                     Kategorie-Reiter wirken (Beschriftung und Pastellfarbe
                     setzt HelloController). -->
                <Separator orientation="VERTICAL"/>
                <Button fx:id="exportSelectedToolButton" onAction="#onExportSelected"/>
                <Button fx:id="importCategoryToolButton" onAction="#onImportCategory"/>
                <!-- Zweiter Trennstrich, deutlich abgesetzt: rechts davon
                     die beiden Knöpfe, die die Zusatzfenster "Decoder" und
                     "Systeme" öffnen. Die drei Decoder-Knöpfe, die hier bis
                     2.0.1 standen, liegen jetzt im Ribbon des Decoder-Fensters.
                     Die Regionen sind nötig, weil eine ToolBar ihren Abstand
                     fest vorgibt - der Trennstrich allein stünde sonst zu
                     dicht an den Schaltflächen. -->
                <Region minWidth="30"/>
                <Separator orientation="VERTICAL"/>
                <Region minWidth="10"/>
                <Button fx:id="decoderWindowButton" onAction="#onOpenDecoderWindow"/>
                <!-- Auch die beiden Fensterknöpfe untereinander abgesetzt. -->
                <Region minWidth="10"/>
                <Separator orientation="VERTICAL"/>
                <Region minWidth="10"/>
                <Button fx:id="systemsWindowButton" onAction="#onOpenSystemsWindow"/>
            </ToolBar>
            <Label fx:id="fileNameLabel" text="Keine Datei geladen.">
                <VBox.margin>
                    <Insets top="6" right="10" bottom="6" left="10"/>
                </VBox.margin>
            </Label>
        </VBox>
    </top>
    <center>
        <!-- Solange keine Datei geladen ist, zeigt die Mitte das Programm-
             symbol (die Dampflok), an die Fenstergröße gebunden - siehe
             HelloController.initStartImage(). Die Reiter je control-items-
             Kategorie werden zur Laufzeit erzeugt, sobald eine Datei
             geöffnet wurde; das Bild verschwindet dann. -->
        <StackPane fx:id="centerPane">
            <TabPane fx:id="tabPane"/>
            <ImageView fx:id="startImage" preserveRatio="true" smooth="true" mouseTransparent="true"/>
        </StackPane>
    </center>
    <bottom>
        <Label fx:id="statusLabel" text="" BorderPane.alignment="CENTER_LEFT">
            <padding>
                <Insets top="4" right="10" bottom="4" left="10"/>
            </padding>
        </Label>
    </bottom>
</BorderPane>
